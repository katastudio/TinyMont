dialog_lines = ["Las manos se acuerdan de cada acorde.", "La guitarra y el barrio, mis dos amores."]
mision_id = "salina_zapada"
dialog_encargo = ["Buenas, pibe. Me dicen Don Salina, guitarrista de acá.", "Quiero zapar con Gille en la plaza esta tarde.", "¿Le avisás que lo espero? Volvé con su respuesta."]
dialog_recordatorio = ["¿Hablaste con Gille? Anda por la plaza con su trompeta."]
dialog_entrega = ["¡Viene! Hoy la plaza suena lindo.", "Tomá esta púa de madera. Hecha a mano, como todo lo bueno."]
requisito_item = "aviso_gille"
recompensa_item = "pua"

[node name="Rodri" parent="." instance=ExtResource("npc_src")]
position = Vector2(216, 216)
npc_name = "Rodri"
rutina = 3
pelo = "slick"
pelo_color = Color(0.101961, 0.101961, 0.101961, 1)
vello_facial = "stubble"
camiseta = Color(0.478431, 0.227451, 0.690196, 1)
marca = "badge"
dialog_lines = ["La cumbia es el idioma del barrio.", "¡Esta noche se baila!"]
mision_id = "rodri_invitaciones"
dialog_encargo = ["¡Eeeh! Soy Rodri, canto cumbia desde pibe.", "Hoy hago un show y quiero el barrio lleno.", "Repartí invitaciones a 3 vecinos y volvé."]
dialog_recordatorio = ["Faltan invitaciones. ¡Hablá con más vecinos!"]
dialog_entrega = ["¡Va a estar lleno! Sos un groso.", "Tomá mi CD de cumbia, firmado y todo."]
requisito_contador = 3
linea_contacto = "¿Una invitación al show de Rodri? ¡Ahí voy a estar!"
recompensa_item = "cd_cumbia"

[node name="JuliNoticias" parent="." instance=ExtResource("npc_src")]
position = Vector2(232, 488)
npc_name = "Juli Noticias"
rutina = 3
pelo = "long"
pelo_color = Color(0.909804, 0.752941, 0.439216, 1)
lentes = true
camiseta = Color(0.956863, 0.956863, 0.956863, 1)
marca = "badge"
marca_color = Color(0.847059, 0.188235, 0.188235, 1)
dialog_lines = ["Una buena nota empieza escuchando.", "El barrio siempre tiene algo para contar."]
mision_id = "juli_entrevista"
requiere_completadas = 5
dialog_bloqueada = ["Hola, soy Juli, la periodista del barrio.", "Quiero hacerle una nota al recién llegado...", "...pero primero el barrio te tiene que conocer. Ayudá a 5 vecinos y volvé."]
dialog_encargo = ["¡Ahora sí! Todo el barrio habla de vos.", "Contame: ¿qué es lo que más te gusta de Monte Grande?", "Perfecto. Sale en la tapa de mañana."]
dialog_recordatorio = ["La nota ya está en imprenta."]
dialog_entrega = ["Tomá, te guardé la portada. ¡Sos noticia!"]
recompensa_item = "portada"
ayudas = [{"mision": "caby_movil", "item": "confirmacion_juli", "lineas": ["¿El móvil sale de la plaza? ¡Gracias por avisar!", "Decile a Caby que ahí estaré."], "recordatorio": ["Ya le confirmé a Caby, gracias."]}]

[node name="Caby" parent="." instance=ExtResource("npc_src")]
position = Vector2(424, 504)
npc_name = "Caby"
rutina = 3
pelo = "slick"
pelo_color = Color(0.941176, 0.941176, 0.941176, 1)
camiseta = Color(0.658824, 0.815686, 0.941176, 1)
dialog_lines = ["La elegancia no se compra, se practica.", "¡Buenas tardes, Monte Grande!"]
mision_id = "caby_movil"
dialog_encargo = ["Buenas tardes. Me dicen Caby, conductor de la tele.", "El móvil de TV sale desde la plaza en un rato.", "¿Le avisás a Juli Noticias? Necesito que confirme."]
dialog_recordatorio = ["¿Ya hablaste con Juli? Suele estar cerca del Municipio."]
dialog_entrega = ["¡Confirmado! Salimos en vivo.", "Tomá esta corbata. Para las ocasiones especiales."]
requisito_item = "confirmacion_juli"
recompensa_item = "corbata"

[node name="ElAtajatodo" parent="." instance=ExtResource("npc_src")]
position = Vector2(504, 296)
npc_name = "El Atajatodo"
rutina = 3
pelo = "short"
pelo_color = Color(0.909804, 0.752941, 0.439216, 1)
camiseta = Color(0.184314, 0.658824, 0.309804, 1)
marca = "badge"
dialog_lines = ["Bajo los tres palos no pasa nada.", "Concentración, arquero, concentración."]
mision_id = "atajatodo_guantes"
dialog_encargo = ["¡Qué hacés, crack! Soy el Atajatodo, el arquero.", "Perdí mis guantes de la suerte cerca del club.", "Sin ellos no atajo ni un resfrío. ¿Me los buscás?"]
dialog_recordatorio = ["Los guantes tienen que estar por el club, fijate bien."]
dialog_entrega = ["¡Mis guantes! Ahora sí, que vengan los penales.", "Tomá estos dorados. Para que atajes todo vos también."]
requisito_item = "guantes"
recompensa_item = "guantes_dorados"
ayudas = [{"mision": "roman_practica", "item": "aviso_atajatodo", "lineas": ["¿Práctica mañana? ¡Ahí voy a estar!", "Decile a Román que cuente conmigo."], "recordatorio": ["Ya le dije que voy, gracias."]}]

